{
  "id": "azahar",
  "name": "Azahar",
  "kind": "emulator",
  "folder": "Nintendo 3DS",
  "detect": "azahar.exe",
  "version": { "from": "date" },
  "consoles": ["3ds"],
  "baseFor": ["3ds"],
  "license": "GPL-2.0-or-later",
  "portable": [{ "type": "folder", "path": "user" }],
  "saves": ["user/sdmc"],
  "config": ["user/config"],
  "perGame": { "mods": ["user/load/mods/{titleId}", "user/load/textures/{titleId}"] },
  "install": [{ "formats": ["cia"], "args": ["--install", "{file}"] }],
  "updates": { "source": "github", "repo": "azahar-emu/azahar" },
  "asset": "^azahar-windows-msvc-[0-9.]+(-alpha[0-9]+)?\\.zip$"
}
