{
  "id": "dusklight",
  "name": "Dusklight",
  "kind": "port",
  "folder": "GameCube",
  "game": "The Legend of Zelda: Twilight Princess",
  "detect": "dusklight.exe",
  "version": { "from": "exe" },
  "license": "CC0-1.0",
  "portable": [{ "type": "rename", "from": "Datos", "path": "data", "link": "%APPDATA%/TwilitRealm/Dusklight" }, { "type": "folder", "path": "data" }],
  "saves": ["data/EUR", "data/USA", "data/JAP"],
  "config": ["data/config.json"],
  "gamePaths": [{ "file": "data/config.json", "format": "json", "key": "backend.isoPath" }],
  "perGame": { "config": "data/config.json", "apply": "swap", "mods": ["data/mods"], "modsArg": "--mods" },
  "options": [
    { "name": "resolution", "file": "data/config.json", "format": "json", "key": "game.internalResolutionScale" },
    { "name": "fps", "file": "data/config.json", "format": "json", "key": "video.maxFrameRate" },
    { "name": "vsync", "file": "data/config.json", "format": "json", "key": "video.enableVsync" },
    { "name": "aspectRatio", "file": "data/config.json", "format": "json", "key": "video.lockAspectRatio" },
    { "name": "renderer", "file": "data/config.json", "format": "json", "key": "backend.graphicsBackend" }
  ],
  "updates": { "source": "github", "repo": "TwilitRealm/dusklight" },
  "asset": "^Dusklight-v.*-win32-x86_64\\.zip$",
  "formats": ["iso", "rvz", "gcm"]
}
