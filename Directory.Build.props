<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Avisos de paquetes NuGet de terceros no deben romper la compilación -->
    <WarningsNotAsErrors>NU1603;NU1608;NU1701;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
