        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          }
        }
      },
      "MoveState": {
        "required": [
          "step",
          "done",
          "total",
          "running",
          "destination",
          "error",
          "warning"
        ],
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "done": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "running": {
            "type": "boolean"
          },
          "destination": {
            "type": [
              "null",
              "string"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          },
          "warning": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          }
        }
      },
