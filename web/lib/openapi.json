{
  "openapi": "3.1.1",
  "info": {
    "title": "Otteretro | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:53727/"
    }
  ],
  "paths": {
    "/api/state": {
      "get": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppState"
                }
              }
            }
          }
        }
      }
    },
    "/api/data-folder": {
      "post": {
        "tags": [
          "Otteretro"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppState"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/data-folder/move": {
      "get": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveState"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Otteretro"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveState"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/language": {
      "put": {
        "tags": [
          "Otteretro"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LanguageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppState"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/drives": {
      "get": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Drive"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/update": {
      "get": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateState"
                }
              }
            }
          }
        }
      }
    },
    "/api/update/check": {
      "post": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateState"
                }
              }
            }
          }
        }
      }
    },
    "/api/update/restart": {
      "post": {
        "tags": [
          "Otteretro"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AppState": {
        "required": [
          "version",
          "dataFolder",
          "configured",
          "language"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "dataFolder": {
            "type": [
              "null",
              "string"
            ]
          },
          "configured": {
            "type": "boolean"
          },
          "language": {
            "type": "string"
          }
        }
      },
      "Drive": {
        "required": [
          "name",
          "free",
          "total"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "free": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "FolderInfo": {
        "required": [
          "path",
          "used",
          "freeOnDrive"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "null",
              "string"
            ]
          },
          "used": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "freeOnDrive": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "FolderRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "LanguageRequest": {
        "required": [
          "language"
        ],
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          }
        }
      },
      "MoveState": {
        "required": [
          "step",
          "done",
          "total",
          "running",
          "destination",
          "error",
          "warning"
        ],
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "done": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "running": {
            "type": "boolean"
          },
          "destination": {
            "type": [
              "null",
              "string"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          },
          "warning": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          }
        }
      },
      "UpdatePhase": {
        "enum": [
          "None",
          "Unavailable",
          "Checking",
          "UpToDate",
          "Downloading",
          "Ready",
          "Error"
        ]
      },
      "UpdateState": {
        "required": [
          "phase",
          "version",
          "progress",
          "message",
          "checkedAt"
        ],
        "type": "object",
        "properties": {
          "phase": {
            "$ref": "#/components/schemas/UpdatePhase"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "progress": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "checkedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Otteretro"
    }
  ]
}