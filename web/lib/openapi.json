        "required": [
          "id",
          "kind",
          "status",
          "progress",
          "detail",
          "createdAt",
          "finishedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "progress": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiError"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdatePhase": {
        "enum": [
          "None",
          "Unavailable",
          "Checking",
          "UpToDate",
          "Downloading",
          "Ready",
          "Error"
        ]
      },
      "UpdateState": {
        "required": [
          "phase",
          "version",
          "progress",
          "message",
          "checkedAt"
        ],
        "type": "object",
        "properties": {
          "phase": {
            "$ref": "#/components/schemas/UpdatePhase"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "progress": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "checkedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
