<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WinExe: sin ventana de consola al abrir la app; la CLI se engancha a la consola que la llamó -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Otteretro</RootNamespace>
    <AssemblyName>Otteretro</AssemblyName>
    <ApplicationIcon>nutria.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Downloader" Version="5.10.2" />
    <PackageReference Include="MegaApiClient" Version="1.10.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
    <!-- Los textos de la interfaz, para la ventana de error de `jugar` (#399). -->
    <EmbeddedResource Include="..\..\web\messages\*.json" LogicalName="messages/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\prompts\*.md" LogicalName="prompts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\recetas\*.json" LogicalName="recetas/%(Filename)%(Extension)" />
    <None Include="nutria.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- La interfaz: Next.js exportado en web/out se sirve como wwwroot. -->
  <PropertyGroup>
    <WebDir>$(MSBuildThisFileDirectory)..\..\web\</WebDir>
  </PropertyGroup>
  <!-- En Release se compila el front; en Debug se copia el último web/out si existe. Se copia al terminar
       (no como Content) porque Next genera nombres nuevos en cada build. -->
  <Target Name="BuildWeb" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SkipWeb)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>
  <Target Name="CopyWeb" AfterTargets="Build">
    <ItemGroup>
      <WebFile Include="$(WebDir)out\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(WebFile)" DestinationFiles="@(WebFile->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishWeb" AfterTargets="Publish">
    <ItemGroup>
      <WebFile Include="$(WebDir)out\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebFile)" DestinationFiles="@(WebFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- DolphinTool y chdman, en el repo con su licencia (#232, #241). Se actualizan con scripts/herramientas.ps1. -->
  <ItemGroup>
    <Content Include="herramientas\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- El catálogo que trae la app, sin nada de la persona (#211). Se regenera con `otteretro catalogo exportar`. -->
    <Content Include="catalogo\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
