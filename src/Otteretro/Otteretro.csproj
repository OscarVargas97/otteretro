<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WinExe: sin ventana de consola al abrir la app; la CLI se engancha a la consola que la llamó -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Otteretro</RootNamespace>
    <AssemblyName>Otteretro</AssemblyName>
    <ApplicationIcon>nutria.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Datos\Migraciones\*.sql" />
    <None Include="nutria.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- La interfaz: Next.js exportado en web/out se sirve como wwwroot. -->
  <PropertyGroup>
    <DirWeb>$(MSBuildThisFileDirectory)..\..\web\</DirWeb>
  </PropertyGroup>
  <!-- En Release se compila el front; en Debug se copia el último web/out si existe. Se copia al terminar
       (no como Content) porque Next genera nombres nuevos en cada build. -->
  <Target Name="ConstruirWeb" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SaltarWeb)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(DirWeb)" Condition="!Exists('$(DirWeb)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(DirWeb)" />
  </Target>
  <Target Name="CopiarWeb" AfterTargets="Build">
    <ItemGroup>
      <ArchivoWeb Include="$(DirWeb)out\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(ArchivoWeb)" DestinationFiles="@(ArchivoWeb->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublicarWeb" AfterTargets="Publish">
    <ItemGroup>
      <ArchivoWeb Include="$(DirWeb)out\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArchivoWeb)" DestinationFiles="@(ArchivoWeb->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
